local function getCrateRarity(item)
    local tier = item:GetAttribute("CrateTier")
    if not tier then
        local val = item:FindFirstChild("CrateTier")
        if val then tier = val.Value end
    end
    local strTier = tostring(tier or "Common")
    if strTier == "Eternal" then
        return "Divine"
    end
    return strTier
end

local function getCrateName(item)
    local areaId = item:GetAttribute("AreaId")
    if not areaId then
        local val = item:FindFirstChild("AreaId")
        if val then areaId = val.Value end
    end
    return tostring(areaId or item.Name)
end

local function getCratePart(item)
    if item:IsA("BasePart") then
        return item
    elseif item:IsA("Model") then
        return item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function getCrateDistance(item)
    local part = getCratePart(item)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if part and hrp then
        return (hrp.Position - part.Position).Magnitude
    end
    return math.huge
end

local function getCrateWeight(item)
    local weightAttr = item:GetAttribute("CrateKg") or item:GetAttribute("Weight") or item:GetAttribute("KG") or item:GetAttribute("Mass")
    if type(weightAttr) == "number" then return weightAttr end

    for _, desc in ipairs(item:GetDescendants()) do
        if desc.Name == "CrateKg" or desc.Name == "Weight" or desc.Name == "KG" or desc.Name == "Mass" then
            if desc:IsA("NumberValue") or desc:IsA("IntValue") then
                return desc.Value
            elseif desc:IsA("StringValue") then
                local num = tonumber(string.match(desc.Value, "%d+%.?%d*"))
                if num then return num end
            end
        end
    end

    if item:IsA("Model") then
        local ok, size = pcall(function() return item:GetExtentsSize() end)
        if ok and size then return size.Magnitude end
    end
    
    local part = getCratePart(item)
    return part and part.Size.Magnitude or 0
end

local function instantPrompt(item)
    if item:IsA("ProximityPrompt") then item.HoldDuration = 0 end
    for _, desc in ipairs(item:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then desc.HoldDuration = 0 end
    end
end

