local function getRarityBaseColor(rarity)
    if rarity == "Common" then return Color3.fromRGB(255, 255, 255)
    elseif rarity == "Uncommon" then return Color3.fromRGB(50, 205, 50)
    elseif rarity == "Rare" then return Color3.fromRGB(0, 120, 255)
    elseif rarity == "Epic" then return Color3.fromRGB(186, 85, 211)
    elseif rarity == "Legendary" then return Color3.fromRGB(255, 140, 0)
    elseif rarity == "Mythic" then return Color3.fromRGB(255, 0, 0)
    elseif rarity == "Cosmic" then return Color3.fromRGB(75, 0, 130)
    elseif rarity == "Secret" then return Color3.fromRGB(100, 100, 100)
    elseif rarity == "Divine" then return Color3.fromRGB(255, 220, 50) end
    return Color3.fromRGB(255, 255, 255)
end

local function setupESP(item)
    local targetPart = getCratePart(item)
    if not targetPart then return end

    local crateName = getCrateName(item)
    local crateRarity = getCrateRarity(item)

    if not globalEspEnabled or not rarityToggles[crateRarity] then
        removeESP(item)
        return
    end

    removeESP(item)

    local baseColor = getRarityBaseColor(crateRarity)

    local highlight = Instance.new("Highlight", item)
    highlight.Name = "CrateESP_Highlight"
    highlight.Adornee = item
    highlight.FillColor = baseColor
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 1

    local billboard = Instance.new("BillboardGui", item)
    billboard.Name = "CrateESP_Gui"
    billboard.Size = UDim2.new(0, 140, 0, 45)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = targetPart

    local nameLabel = Instance.new("TextLabel", billboard)
    nameLabel.Name = "ESPNameText"
    nameLabel.Size = UDim2.new(1, 0, 0, 22)
    nameLabel.Position = UDim2.new(0, 0, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = baseColor
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextSize = 15
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.Text = crateName

    local distLabel = Instance.new("TextLabel", billboard)
    distLabel.Name = "ESPDistText"
    distLabel.Size = UDim2.new(1, 0, 0, 16)
    distLabel.Position = UDim2.new(0, 0, 0, 20)
    distLabel.BackgroundTransparency = 1
    distLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    distLabel.TextStrokeTransparency = 0
    distLabel.TextSize = 10
    distLabel.Font = Enum.Font.SourceSansBold
    distLabel.Text = "< ? m >"

    local espThread = task.spawn(function()
        local tickCount = 0
        while billboard and billboard.Parent and targetPart and targetPart.Parent and globalEspEnabled and rarityToggles[crateRarity] do
            tickCount = tickCount + 0.1
            
            if crateRarity == "Divine" then
                local tVal = (math.sin(tickCount * 3) + 1) / 2
                local dynamicColor = Color3.fromRGB(255, 180, 0):Lerp(Color3.fromRGB(0, 200, 255), tVal)
                nameLabel.TextColor3 = dynamicColor
                highlight.FillColor = dynamicColor
            end

            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local distance = (character.HumanoidRootPart.Position - targetPart.Position).Magnitude
                distLabel.Text = string.format("< %d m >", math.floor(distance))
            else
                distLabel.Text = "[Jarak: ?]"
            end
            task.wait(0.1)
        end
    end)
    table.insert(getgenv().StealAnRich_Connections, espThread)
end

local function refreshAllESP()
    for _, item in ipairs(FOLDER_PATH:GetChildren()) do
        setupESP(item)
    end
end

local function triggerPrompts(target)
    if target:IsA("ProximityPrompt") then fireproximityprompt(target) end
    local descendants = target:GetDescendants()
    for i = 1, #descendants do
        local desc = descendants[i]
        if desc:IsA("ProximityPrompt") then fireproximityprompt(desc) end
    end
end

local function hasActivePrompt(item)
    if not item or not item.Parent then return false end
    if item:IsA("ProximityPrompt") and item.Enabled then return true end
    for _, desc in ipairs(item:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled then
            return true
        end
    end
    return false
end

-- Fungsi Helper untuk Dismount & TP ke Kanan jika Auto Treadmill Menyala
local function checkAndDismountTreadmill()
    if autoTreadmillEnabled then
        pcall(function()
            local character = LocalPlayer.Character
            if character then
                local hrp = character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = hrp.CFrame + (hrp.CFrame.RightVector * 5)
                end
            end
            
            local dismountEvent = ReplicatedStorage:FindFirstChild("Shared") 
                and ReplicatedStorage.Shared.Packages 
                and ReplicatedStorage.Shared.Packages.Network 
                and ReplicatedStorage.Shared.Packages.Network:FindFirstChild("rev_TREADMILL_DISMOUNT")
            if dismountEvent then
                dismountEvent:FireServer()
            end
        end)
        task.wait(0.1)
    end
end

-- Proses Otomatis Koleksi Crate Sesuai Alur 5 Langkah Anda
local function processCrateCollection(item)
    if not item or not item.Parent then return end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    checkAndDismountTreadmill()

    isBusyWithCrate = true
    lastActionTick = tick()

    local hrp = character.HumanoidRootPart
    local originalPosition = customBasePosition and CFrame.new(customBasePosition) or hrp.CFrame

    -- Langkah 1: Target/tujuan yang dipilih (item) sudah diingat.

    -- Langkah 2: Cari crate berjarak paling dekat dari player saat ini (murni fisik terdekat untuk trigger guard)
    local closestCrate = nil
    local shortestDist = math.huge
    for _, child in ipairs(FOLDER_PATH:GetChildren()) do
        if hasActivePrompt(child) and getCratePart(child) then
            local dist = getCrateDistance(child)
            if dist < shortestDist then
                shortestDist = dist
                closestCrate = child
            end
        end
    end

    local baitCrate = closestCrate or item
    local baitPart = getCratePart(baitCrate)

    if baitPart then
        local baitCF = baitPart.CFrame + Vector3.new(0, 3, 0)
        local distBait = (hrp.Position - baitCF.Position).Magnitude
        local durBait = math.clamp(distBait / 250, 0.2, 1.5)
        
        local tweenBait = TweenService:Create(hrp, TweenInfo.new(durBait, Enum.EasingStyle.Linear), {CFrame = baitCF})
        tweenBait:Play()
        tweenBait.Completed:Wait()

        local pickStart = tick()
        while baitCrate and baitCrate.Parent == FOLDER_PATH and (tick() - pickStart < 3) do
            triggerPrompts(baitCrate)
            task.wait(0.05)
        end

        -- Diam tunggu sampai terlempar oleh guard / crate terlepas
        while baitCrate do
            local parent = baitCrate.Parent
            if parent == FOLDER_PATH or parent == nil then
                break
            end
            if hrp.AssemblyLinearVelocity.Magnitude > 45 then
                break
            end
            task.wait(0.05)
        end
    end

    -- Langkah 3 & 4: Ketika sudah terlempar, tunggu beberapa saat hingga proximity crate pilihan muncul, lalu teleport & ambil
    if item and item.Parent == FOLDER_PATH then
        local waitPromptStart = tick()
        while item and item.Parent == FOLDER_PATH and not hasActivePrompt(item) and (tick() - waitPromptStart < 5) do
            task.wait(0.05)
        end

        local targetPart = getCratePart(item)
        if targetPart then
            hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)

            while item and item.Parent == FOLDER_PATH and hasActivePrompt(item) do
                triggerPrompts(item)
                task.wait(0.05)
            end

            -- Langkah 5: Jika Feed aktif tetap tween ke posisi feed (dengan pemantauan jika crate terlepas di tengah jalan), jika tidak aktif (Base) langsung teleport
            if feedAreaEnabled and feedTargetPosition then
                local feedCF = CFrame.new(feedTargetPosition)
                local feedDist = (hrp.Position - feedTargetPosition).Magnitude
                local feedDuration = math.clamp(feedDist / 250, 1.0, 7.0)
                
                local feedTween = TweenService:Create(hrp, TweenInfo.new(feedDuration, Enum.EasingStyle.Linear), {CFrame = feedCF})
                feedTween:Play()
                
                local interrupted = false
                while feedTween.PlaybackState == Enum.PlaybackState.Playing do
                    if item and item.Parent == FOLDER_PATH and hasActivePrompt(item) then
                        interrupted = true
                        feedTween:Cancel()
                        break
                    end
                    task.wait(0.05)
                end
                
                -- Jika di tengah jalan crate terlepas/aktif kembali proximitynya, hentikan tween dan ulangi dari posisi berhenti
                if interrupted then
                    return processCrateCollection(item)
                end
                
                pcall(function()
                    local dropEvent = ReplicatedStorage:FindFirstChild("Shared") 
                        and ReplicatedStorage.Shared.Packages 
                        and ReplicatedStorage.Shared.Packages.Network 
                        and ReplicatedStorage.Shared.Packages.Network:FindFirstChild("rev_CRATE_DROP")
                    if dropEvent then
                        dropEvent:FireServer()
                    end
                end)
            else
                hrp.CFrame = originalPosition
            end
        end
    else
        hrp.CFrame = originalPosition
    end

    isBusyWithCrate = false
    lastActionTick = tick()
end

