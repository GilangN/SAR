updateCrateFilterUI = function()
    local children = crateFilterScroll:GetChildren()
    for i = 1, #children do
        local child = children[i]
        if child:IsA("Frame") then child:Destroy() end
    end

    local uniqueCrates = {}
    local seen = {}
    for _, item in ipairs(FOLDER_PATH:GetChildren()) do
        local cName = getCrateName(item)
        local cRarity = getCrateRarity(item)
        if rarityToggles[cRarity] and not seen[cName] then
            seen[cName] = true
            table.insert(uniqueCrates, cName)
        end
    end

    table.sort(uniqueCrates, function(a, b)
        return a < b
    end)

    for i = 1, #uniqueCrates do
        local crateName = uniqueCrates[i]
        if crateAutoToggles[crateName] == nil then
            crateAutoToggles[crateName] = true
        end
        local isStateOn = crateAutoToggles[crateName]

        local crateRow = Instance.new("Frame", crateFilterScroll)
        crateRow.Size = UDim2.new(1, 0, 0, 24)
        crateRow.BackgroundTransparency = 1

        local crateBtn = Instance.new("TextButton", crateRow)
        crateBtn.Size = UDim2.new(1, 0, 1, 0)
        crateBtn.BackgroundColor3 = isStateOn and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(120, 0, 0)
        crateBtn.BackgroundTransparency = 0.2
        crateBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        crateBtn.TextSize = 11
        crateBtn.Font = Enum.Font.SourceSansBold
        crateBtn.Text = crateName .. ":" .. (isStateOn and "ON" or "OFF")
        Instance.new("UICorner", crateBtn).CornerRadius = UDim.new(0, 4)

        crateBtn.MouseButton1Click:Connect(function()
            crateAutoToggles[crateName] = not crateAutoToggles[crateName]
            local state = crateAutoToggles[crateName]
            crateBtn.BackgroundColor3 = state and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(120, 0, 0)
            crateBtn.Text = crateName .. ":" .. (state and "ON" or "OFF")
            saveSettings()
        end)
    end
end

-- Background Loop: Auto Farm (Mengambil Crate Berdasarkan Urutan Rarity Tertinggi ke Terendah)
local farmThread = task.spawn(function()
    while true do
        if autoFarmEnabled then
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local farmedAny = false
                
                local children = FOLDER_PATH:GetChildren()
                table.sort(children, function(a, b)
                    local weightA = rarityWeights[getCrateRarity(a)] or 0
                    local weightB = rarityWeights[getCrateRarity(b)] or 0
                    if weightA ~= weightB then return weightA > weightB end
                    
                    local sizeA, sizeB = getCrateWeight(a), getCrateWeight(b)
                    if sizeA ~= sizeB then return sizeA > sizeB end
                    
                    return getCrateName(a) < getCrateName(b)
                end)

                for i = 1, #children do
                    local item = children[i]
                    if not autoFarmEnabled then break end
                    local crateName = getCrateName(item)
                    local crateRarity = getCrateRarity(item)
                    
                    if rarityToggles[crateRarity] and (crateAutoToggles[crateName] ~= false) and hasActivePrompt(item) and getCratePart(item) then
                        farmedAny = true
                        processCrateCollection(item)
                        break
                    end
                end
                if not farmedAny then task.wait(0.1) end
            else
                task.wait(0.5)
            end
        else
            task.wait(0.5)
        end
    end
end)
table.insert(getgenv().StealAnRich_Connections, farmThread)

-- Background Loop: Deteksi Idle 7 Detik & Cek Gerakan Pemain sebelum Teleport ke Treadmill
local treadmillIdleThread = task.spawn(function()
    while true do
        task.wait(0.5)
        if autoTreadmillEnabled and not isBusyWithCrate then
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            
            if humanoid and humanoid.MoveDirection.Magnitude > 0.1 then
                lastActionTick = tick()
            else
                if (tick() - lastActionTick) >= 7 then
                    local hasAvailableCrate = false
                    if autoFarmEnabled then
                        for _, item in ipairs(FOLDER_PATH:GetChildren()) do
                            local crateRarity = getCrateRarity(item)
                            local crateName = getCrateName(item)
                            if rarityToggles[crateRarity] and (crateAutoToggles[crateName] ~= false) and hasActivePrompt(item) and getCratePart(item) then
                                hasAvailableCrate = true
                                break
                            end
                        end
                    end

                    if not hasAvailableCrate then
                        local treadmillPart = nil
                        local treadmillName = "PersonalTreadmill_" .. LocalPlayer.UserId
                        for _, desc in ipairs(Workspace:GetDescendants()) do
                            if desc.Name == treadmillName then
                                if desc:IsA("BasePart") then
                                    treadmillPart = desc
                                    break
                                elseif desc:IsA("Model") then
                                    treadmillPart = desc.PrimaryPart or desc:FindFirstChildWhichIsA("BasePart")
                                    if treadmillPart then break end
                                end
                            end
                        end

                        if treadmillPart and character and character:FindFirstChild("HumanoidRootPart") then
                            local hrp = character.HumanoidRootPart
                            if (hrp.Position - treadmillPart.Position).Magnitude > 5 then
                                hrp.CFrame = treadmillPart.CFrame + Vector3.new(0, 3, 0)
                            end
                        end
                    end
                end
            end
        end
    end
end)
table.insert(getgenv().StealAnRich_Connections, treadmillIdleThread)

