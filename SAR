-- Proses Otomatis Koleksi Crate dengan Looping Dismount Treadmill Murni (Tanpa TP Samping)
local function processCrateCollection(item)
    if not item or not item.Parent then return false end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
    
    isBusyWithCrate = true
    lastActionTick = tick()

    -- Looping event dismount treadmill secara konstan tanpa TP samping selama proses pengambilan crate
    local dismountLoopTask = task.spawn(function()
        while isBusyWithCrate do
            pcall(function()
                local dismountEvent = ReplicatedStorage:FindFirstChild("Shared") 
                    and ReplicatedStorage.Shared.Packages 
                    and ReplicatedStorage.Shared.Packages.Network 
                    and ReplicatedStorage.Shared.Packages.Network:FindFirstChild("rev_TREADMILL_DISMOUNT")
                if dismountEvent then
                    dismountEvent:FireServer()
                end
            end)
            task.wait(0.2)
        end
    end)

    local hrp = character.HumanoidRootPart
    updateAutomaticBase() -- Cek ulang base otomatis plot player
    local originalPosition = customBasePosition and CFrame.new(customBasePosition) or hrp.CFrame

    -- CEK JARAK TARGET UTAMA (Jika dalam radius 100 studs, ABAIKAN BAIT)
    local targetDist = getCrateDistance(item)
    local baitSuccess = (targetDist <= 100)

    -- JIKA DI LUAR 100 STUDS -> JALANKAN VALIDASI MUTLAK BAIT 2 TAHAP
    local baitAttempts = 0
    local maxBaitAttempts = 3

    while not baitSuccess and baitAttempts < maxBaitAttempts do
        baitAttempts = baitAttempts + 1

        local closestCrate = nil
        local shortestDist = math.huge
        for _, child in ipairs(FOLDER_PATH:GetChildren()) do
            if child ~= item and hasActivePrompt(child) and getCratePart(child) then
                local dist = getCrateDistance(child)
                if dist < shortestDist then
                    shortestDist = dist
                    closestCrate = child
                end
            end
        end

        if not closestCrate or not hasActivePrompt(closestCrate) then
            baitSuccess = true
            break
        end

        local baitPart = getCratePart(closestCrate)
        if not baitPart then
            baitSuccess = true
            break
        end

        -- TAHAP 1: TWEEN BERULANG KE TARGET BAIT SAMPAI SUKSES TERANGKAT (PROXIMITY HILANG)
        local step1Success = false
        local t1 = tick()
        while closestCrate and closestCrate.Parent == FOLDER_PATH and (tick() - t1 < 8) do
            if not hasActivePrompt(closestCrate) then
                step1Success = true
                break
            end
            
            local currentBaitPart = getCratePart(closestCrate)
            if currentBaitPart and hrp then
                local baitCF = currentBaitPart.CFrame + Vector3.new(0, 3, 0)
                local distBait = (hrp.Position - baitCF.Position).Magnitude
                if distBait > 4 then
                    local durBait = math.clamp(distBait / 250, 0.1, 1.0)
                    local tweenBait = TweenService:Create(hrp, TweenInfo.new(durBait, Enum.EasingStyle.Linear), {CFrame = baitCF})
                    tweenBait:Play()
                    tweenBait.Completed:Wait()
                end
            end
            
            triggerPrompts(closestCrate)
            task.wait(0.05)
        end

        if not step1Success then
            task.wait(0.2)
            continue
        end

        -- TAHAP 2: DIAM DAN TUNGGU SAMPAI PROXIMITY CRATE BAIT KEMBALI MUNCUL (SUKSES TERLEMPAR)
        local step2Success = false
        local t2 = tick()
        while closestCrate and closestCrate.Parent == FOLDER_PATH and (tick() - t2 < 8) do
            if hasActivePrompt(closestCrate) then
                step2Success = true
                break
            end
            task.wait(0.05)
        end

        if step1Success and step2Success then
            baitSuccess = true
            break
        else
            task.wait(0.2)
        end
    end

    -- JIKA PROSES BAIT GAGAL/TIDAK LENGKAP, BATALKAN
    if not baitSuccess then
        isBusyWithCrate = false
        return false
    end

    -- TAHAP TARGET: Tunggu sampai proximity crate target muncul kembali / aktif, baru boleh teleport
    local waitPromptStart = tick()
    while item and item.Parent == FOLDER_PATH do
        if hasActivePrompt(item) then
            break
        end
        if tick() - waitPromptStart > 10 then -- Timeout 10 detik jika tidak kunjung muncul
            isBusyWithCrate = false
            return false
        end
        task.wait(0.05)
    end

    if not item or item.Parent ~= FOLDER_PATH or not hasActivePrompt(item) then
        isBusyWithCrate = false
        return false
    end

    -- BARU TELEPORT KE CRATE TARGET UTAMA
    while item and item.Parent == FOLDER_PATH do
        local targetPart = getCratePart(item)
        if targetPart then
            if hasActivePrompt(item) then
                hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                triggerPrompts(item)
            else
                break
            end
        else
            break
        end
        task.wait(0.05)
    end

    -- Langkah Terakhir: Proses Pengiriman (Base / Feed)
    local destCF = originalPosition
    if feedAreaEnabled and feedTargetPosition then
        destCF = CFrame.new(feedTargetPosition)
    elseif customBasePosition then
        destCF = CFrame.new(customBasePosition)
    end

    if feedAreaEnabled and feedTargetPosition then
        local destDist = (hrp.Position - destCF.Position).Magnitude
        local destDuration = math.clamp(destDist / 250, 1.0, 7.0)
        
        local destTween = TweenService:Create(hrp, TweenInfo.new(destDuration, Enum.EasingStyle.Linear), {CFrame = destCF})
        destTween:Play()

        local tweenCancelled = false
        local connection
        connection = RunService.Heartbeat:Connect(function()
            if item and item.Parent == FOLDER_PATH and hasActivePrompt(item) then
                destTween:Cancel()
                tweenCancelled = true
                if connection then connection:Disconnect() end
            end
        end)

        destTween.Completed:Wait()
        if connection then connection:Disconnect() end

        if tweenCancelled then
            task.wait(0.1)
            isBusyWithCrate = false
            return processCrateCollection(item)
        end

        pcall(function()
            local dropEvent = ReplicatedStorage:FindFirstChild("Shared") 
                and ReplicatedStorage.Shared.Packages 
                and ReplicatedStorage.Shared.Packages.Network 
                and ReplicatedStorage.Shared.Packages.Network:FindFirstChild("rev_CRATE_DROP")
            if dropEvent then
                dropEvent:FireServer()
            end
        end)
    else
        hrp.CFrame = originalPosition
    end

    isBusyWithCrate = false
    lastActionTick = tick()
    updateUIList()
    return true
end

