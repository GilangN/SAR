local function saveSettings()
    local configData = {
        ESP = globalEspEnabled,
        AutoFarm = autoFarmEnabled,
        AutoHop = autoHopEnabled,
        AutoTreadmill = autoTreadmillEnabled,
        FeedArea = feedAreaEnabled,
        FeedPos = feedTargetPosition and {feedTargetPosition.X, feedTargetPosition.Y, feedTargetPosition.Z} or nil,
        BasePos = customBasePosition and {customBasePosition.X, customBasePosition.Y, customBasePosition.Z} or nil,
        RarityToggles = rarityToggles,
        CrateAutoToggles = crateAutoToggles
    }
    
    local success, encoded = pcall(function()
        return HttpService:JSONEncode(configData)
    end)
    
    if success and writefile then
        pcall(function()
            writefile(CONFIG_FILE, encoded)
        end)
    end
end

local function loadSettings()
    if readfile and isfile and isfile(CONFIG_FILE) then
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)
        
        if success and decoded then
            if decoded.ESP ~= nil then globalEspEnabled = decoded.ESP end
            if decoded.AutoFarm ~= nil then autoFarmEnabled = decoded.AutoFarm end
            if decoded.AutoHop ~= nil then autoHopEnabled = decoded.AutoHop end
            if decoded.AutoTreadmill ~= nil then autoTreadmillEnabled = decoded.AutoTreadmill end
            if decoded.FeedArea ~= nil then feedAreaEnabled = decoded.FeedArea end
            if decoded.FeedPos ~= nil and type(decoded.FeedPos) == "table" then
                feedTargetPosition = Vector3.new(decoded.FeedPos[1], decoded.FeedPos[2], decoded.FeedPos[3])
            end
            if decoded.BasePos ~= nil and type(decoded.BasePos) == "table" then
                customBasePosition = Vector3.new(decoded.BasePos[1], decoded.BasePos[2], decoded.BasePos[3])
            end
            if decoded.RarityToggles ~= nil then
                for rarity, state in pairs(decoded.RarityToggles) do
                    if rarityToggles[rarity] ~= nil then
                        rarityToggles[rarity] = state
                    end
                end
            end
            if decoded.CrateAutoToggles ~= nil then
                for crateName, state in pairs(decoded.CrateAutoToggles) do
                    crateAutoToggles[crateName] = state
                end
            end
        end
    end
end

