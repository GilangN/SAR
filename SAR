local function hopServer()
    setupQueueOnTeleport()
    VisitedServers[game.JobId] = true

    local success, err = pcall(function()
        local servers = {}
        local cursor = ""
        local attempts = 0
        
        repeat
            attempts = attempts + 1
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then
                url = url .. "&cursor=" .. cursor
            end
            
            local reqSucc, response = pcall(function()
                return game:HttpGet(url)
            end)
            
            if not reqSucc or not response then break end
            
            local req = HttpService:JSONDecode(response)
            cursor = req.nextPageCursor
            
            if req.data then
                for _, server in ipairs(req.data) do
                    if server.playing and server.maxPlayers and server.playing < server.maxPlayers then
                        if not VisitedServers[server.id] then
                            table.insert(servers, server)
                        end
                    end
                end
            end
            
        until not cursor or #servers > 0 or attempts > 3
        
        table.sort(servers, function(a, b)
            return a.playing < b.playing
        end)
        
        if #servers > 0 then
            local targetServer = servers[1]
            VisitedServers[targetServer.id] = true
            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer.id, LocalPlayer)
        else
            VisitedServers = {} 
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end
    end)
    
    if not success then
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end
end

