local function getRarityBaseColor(rarity)
    if rarity == "Common" then return Color3.fromRGB(255, 255, 255)
    elseif rarity == "Uncommon" then return Color3.fromRGB(50, 205, 50)
    elseif rarity == "Rare" then return Color3.fromRGB(0, 120, 255)
    elseif rarity == "Epic" then return Color3.fromRGB(186, 85, 211)
    elseif rarity == "Legendary" then return Color3.fromRGB(255, 140, 0)
    elseif rarity == "Mythic" then return Color3.fromRGB(255, 0, 0)
    elseif rarity == "Cosmic" then return Color3.fromRGB(75, 0, 130)
    elseif rarity == "Secret" then return Color3.fromRGB(100, 100, 100)
    elseif rarity == "Divine" then return Color3.fromRGB(255, 220, 50) end
    return Color3.fromRGB(255, 255, 255)
end

